@startuml
title <size:24>Deployment View: CitaSalud Arequipa - Producción</size>\n<size:24>Despliegue en producción (MVP).</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(Producción.CelularoPCdelusuario, "Celular o PC del usuario", $type="Android / navegador web", $descr="", $tags="", $link="") {
  Container(Producción.CelularoPCdelusuario.Aplicaciónwebprogresiva_1, "Aplicación web progresiva", $techn="React + Service Worker", $descr="Interfaz web adaptable para pacientes, personal de admisión y médicos.", $tags="", $link="")
}

Deployment_Node(Producción.VPSenlanube, "VPS en la nube", $type="Ubuntu 24.04 LTS, 2 vCPU, 4 GB RAM", $descr="", $tags="", $link="") {
  Deployment_Node(Producción.VPSenlanube.Nginx, "Nginx", $type="Nginx", $descr="Sirve la PWA estática y reenvía /api a Django (ADR-004).", $tags="", $link="")
  Container(Producción.VPSenlanube.APICitaSalud_1, "API CitaSalud", $techn="Python / Django REST Framework", $descr="Monolito modular que expone la lógica de negocio mediante una API REST.", $tags="", $link="")
  Container(Producción.VPSenlanube.Workerderecordatorios_1, "Worker de recordatorios", $techn="Celery", $descr="Procesa en segundo plano el envío de recordatorios y sus reintentos.", $tags="", $link="")
  ContainerDb(Producción.VPSenlanube.Basededatos_1, "Base de datos", $techn="PostgreSQL 16", $descr="Almacena pacientes, médicos, cupos y citas con aislamiento lógico por esquemas.", $tags="", $link="")
  ContainerQueue(Producción.VPSenlanube.Coladetareasycaché_1, "Cola de tareas y caché", $techn="Redis", $descr="Almacena las tareas asíncronas de notificación y caché de disponibilidad.", $tags="", $link="")
}

Rel(Producción.CelularoPCdelusuario.Aplicaciónwebprogresiva_1, Producción.VPSenlanube.APICitaSalud_1, "Realiza peticiones a la API", $techn="HTTPS/JSON (REST)", $tags="", $link="")
Rel(Producción.VPSenlanube.APICitaSalud_1, Producción.VPSenlanube.Basededatos_1, "Lee y escribe registros transaccionales", $techn="SQL/TCP", $tags="", $link="")
Rel(Producción.VPSenlanube.APICitaSalud_1, Producción.VPSenlanube.Coladetareasycaché_1, "Encola tareas de recordatorio y consulta caché", $techn="Redis protocol", $tags="", $link="")
Rel(Producción.VPSenlanube.Workerderecordatorios_1, Producción.VPSenlanube.Coladetareasycaché_1, "Consume tareas de envío programadas", $techn="Redis protocol", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml