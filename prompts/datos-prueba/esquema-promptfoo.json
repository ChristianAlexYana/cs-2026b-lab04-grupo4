{
  "title": "LoteDatosSinteticosCitaSalud",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lote_id",
    "proposito",
    "pacientes",
    "citas",
    "totales"
  ],
  "properties": {
    "lote_id": {
      "type": "string",
      "pattern": "^LT-[0-9]{4}$"
    },
    "proposito": {
      "type": "string",
      "minLength": 10
    },
    "preguntas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "pacientes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paciente_id",
          "nombres",
          "apellidos",
          "dni",
          "es_ficticio",
          "celular",
          "edad",
          "sexo"
        ],
        "properties": {
          "paciente_id": {
            "type": "string",
            "pattern": "^P-[0-9]{4}$"
          },
          "nombres": {
            "type": "string",
            "pattern": "^Paciente"
          },
          "apellidos": {
            "type": "string",
            "pattern": "Ficticio"
          },
          "dni": {
            "type": "string",
            "pattern": "^(FICTICIO-[0-9]{4}|999[0-9]{5})$"
          },
          "es_ficticio": {
            "const": true
          },
          "celular": {
            "type": "string",
            "pattern": "^999[0-9]{6}$"
          },
          "edad": {
            "type": "integer",
            "minimum": 0,
            "maximum": 110
          },
          "sexo": {
            "enum": [
              "F",
              "M",
              "X"
            ]
          }
        }
      }
    },
    "citas": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cita_id",
          "paciente_id",
          "especialidad",
          "centro",
          "fecha",
          "hora",
          "estado",
          "es_ficticio"
        ],
        "properties": {
          "cita_id": {
            "type": "string",
            "pattern": "^C-[0-9]{4}$"
          },
          "paciente_id": {
            "type": "string",
            "pattern": "^P-[0-9]{4}$"
          },
          "especialidad": {
            "enum": [
              "Medicina General",
              "Pediatria",
              "Cardiologia",
              "Dermatologia",
              "Ginecologia"
            ]
          },
          "centro": {
            "type": "string",
            "pattern": "^Centro de Salud Ficticio [0-9]{2}$"
          },
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "hora": {
            "type": "string",
            "pattern": "^(0[7-9]|1[0-8]):[0-5][0-9]$"
          },
          "estado": {
            "enum": [
              "RESERVADA",
              "CONFIRMADA",
              "CANCELADA",
              "ATENDIDA"
            ]
          },
          "es_ficticio": {
            "const": true
          }
        }
      }
    },
    "totales": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pacientes",
        "citas"
      ],
      "properties": {
        "pacientes": {
          "type": "integer",
          "minimum": 0
        },
        "citas": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
